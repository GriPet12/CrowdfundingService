daemon off;
listen <%= env["PORT"] %>;

server {
    server_name _;
    # Використовуємо глобальний шлях до папки з білдом Vite
    root <%= env["HOME"] %>/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
        expires max;
        add_header Cache-Control "public, must-revalidate, proxy-revalidate";
    }
}