# Heroku автоматично загорне цей блок в секцію http {} під капотом

server {
    listen <%= env["PORT"] %>;
    server_name _;

    # Шлях до зібраного Vite фронтенду
    root /app/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Кешування статики
    location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
        expires max;
        add_header Cache-Control "public, must-revalidate, proxy-revalidate";
    }
}