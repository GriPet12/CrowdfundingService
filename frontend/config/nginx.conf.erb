daemon off;
listen <%= env["PORT"] %>;

server {
    server_name _;
    root /app/dist; # Коли деплоїться суто папка frontend, папка dist створюється прямо в /app
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
        expires max;
        add_header Cache-Control "public, must-revalidate, proxy-revalidate";
    }
}