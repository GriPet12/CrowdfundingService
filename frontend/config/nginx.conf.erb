daemon off;

events {
    worker_connections 1024;
}

http {
    include bin/mime.types;
    default_type application/octet-stream;
    sendfile on;

    server {
        # Директива listen ОБОВ'ЯЗКОВО має бути всередині блоку server
        listen <%= env["PORT"] %>;
        server_name _;

        # Вказуємо точний шлях до папки з білдом Vite у контейнері Heroku
        root /app/dist;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # Кешування для швидкого завантаження активів React
        location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
            expires max;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
        }
    }
}