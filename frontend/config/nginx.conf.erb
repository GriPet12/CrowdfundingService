# Heroku самостійно загорне цей блок у секцію http {} під капотом

server {
    # Використовуємо великі літери ENV для зчитування порту Heroku
    listen <%= ENV["PORT"] %>;
    server_name _;

    # Шлях до папки з білдом Vite всередині контейнера
    root /app/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Кешування статичних ресурсів
    location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
        expires max;
        add_header Cache-Control "public, must-revalidate, proxy-revalidate";
    }
}